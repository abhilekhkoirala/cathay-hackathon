# Copy to .env (never commit .env). Leave SMTP_* empty to run in demo mode (code shown on screen).
PORT=3000

# Amazon SES SMTP. Use the SMTP endpoint for the region where your SES identity is verified.
# NOTE: SMTP_USER / SMTP_PASS are SES *SMTP credentials* (SES console -> SMTP settings -> Create SMTP credentials),
# not your normal AWS access key / secret key.
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Must be an address/domain verified in SES.
MAIL_FROM="Cathay Student Verify <no-reply@your-verified-domain.com>"

# Only needed if the frontend is hosted elsewhere (e.g. GitHub Pages). Comma-separated origins.
ALLOWED_ORIGIN=

# Live demo: real Cathay schedules from the OAG Flight Info API (developers.oag.com).
# Leave empty to use simulated flights. Kept on the server only; never sent to the browser.
OAG_KEY=bdc8929832a44a4e8bad6d120db43e37

# Student chat moderators: comma-separated account emails that can open #/moderation.
MODERATORS=

# Student verification (step 2: student ID). Accounts that can open #/review and approve/reject documents.
VERIFIERS=
# 64 hex chars (32 bytes) used to encrypt uploaded documents at rest. Leave empty in a demo to auto-generate a
# local key in data/vault/.key; in production use a KMS-managed key.
DOC_ENCRYPTION_KEY=
# Bump to require every student to re-verify (e.g. after a policy change).
STUDENT_POLICY_VERSION=1
# 'off' (default): every document is checked by a person. 'pdf-text': clear digital PDFs whose text shows the
# account name, the institution and a future expiry are approved automatically (demo only; see README).
# 'all': DEMO ONLY: every uploaded student ID (JPG/PNG/PDF) is approved immediately, no reviewer needed.
STUDENT_AUTO_APPROVE=all

# Seating operations: comma-separated account emails that can open #/seating-ops (zone size, reviews, manual resolution).
SEAT_OPS=
# Default Student Zone rows (operations can change them per flight) and when unused zone seats return to sale.
ZONE_ROWS_WIDE=48-52
ZONE_ROWS_NARROW=30-33
ZONE_RELEASE_HOURS=24

# Demo staff logins, created when the server starts (sign in with these; no sign-up needed).
# For local demos only: change the passwords, and leave these empty on a server others can reach.
# The deploy script (aws/seat-server.sh) never copies them to a server.
SEED_VERIFIER_EMAIL=verifier@cathay.demo
SEED_VERIFIER_PASSWORD=verify-demo-2026
SEED_OPS_EMAIL=ops@cathay.demo
SEED_OPS_PASSWORD=ops-demo-2026

# Student seating: 'dynamic' (default) = students anywhere in Economy in groups of 2-3, nothing reserved, a paying
# passenger may take a seat only planned for a student (students are re-seated, nobody left alone).
# 'zone' = a protected block of rows (ZONE_ROWS_WIDE / ZONE_ROWS_NARROW), released ZONE_RELEASE_HOURS before departure.
SEATING_MODE=dynamic
